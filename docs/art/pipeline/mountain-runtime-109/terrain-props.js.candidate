/** Actual terrain props: anchors never create knowledge or change passability. */
export function mountainPropPlacements(state,ready,{onlyVisible=true}={}){if(!ready||!state?.map?.tiles)return [];const {width,height,tiles}=state.map,props=[];for(let y=0;y<height;y++)for(let x=0;x<width;x++){const i=y*width+x;if(tiles[i]!=='mountain'||onlyVisible&&state.fog?.visible&&!state.fog.visible[i])continue;props.push({type:'mountain',x:x+.5,y:y+.5,key:`mountain:${x}:${y}`,depth:x+y});}return props;}
export function drawTerrainPropFallback(renderer,ctx,prop,zoom){const p=renderer.project(prop.x,prop.y);if(prop.type==='forest')renderer.tree(ctx,p.x,p.y,zoom,prop.variant);else if(prop.type==='mountain')renderer.rock(ctx,p.x,p.y,zoom,0);}
