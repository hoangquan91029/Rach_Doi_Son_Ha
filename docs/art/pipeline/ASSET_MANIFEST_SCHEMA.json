{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rds:animation-record:v1",
  "title": "Evidence envelope for existing compiled descriptors; not runtime schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rds-animation-record/v1"
    },
    "identityId": {
      "type": "string",
      "minLength": 1
    },
    "unitId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "canonicalReference": {
      "$ref": "#/$defs/pin"
    },
    "job": {
      "$ref": "#/$defs/pin"
    },
    "descriptor": {
      "$ref": "#/$defs/pin"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "pin": {
            "$ref": "#/$defs/pin"
          },
          "status": {
            "enum": [
              "candidate",
              "selected",
              "held",
              "rejected"
            ]
          }
        },
        "required": [
          "pin",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "promptVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "poseVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "name",
        "model",
        "promptVersion",
        "poseVersion",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "sourceWidth": {
          "type": "integer",
          "minimum": 1
        },
        "sourceHeight": {
          "type": "integer",
          "minimum": 1
        },
        "cellWidth": {
          "type": "integer",
          "minimum": 1
        },
        "cellHeight": {
          "type": "integer",
          "minimum": 1
        },
        "pivotX": {
          "type": "number",
          "minimum": 0
        },
        "pivotY": {
          "type": "number",
          "minimum": 0
        },
        "renderWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "renderHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "padding": {
          "const": 2
        }
      },
      "required": [
        "sourceWidth",
        "sourceHeight",
        "cellWidth",
        "cellHeight",
        "pivotX",
        "pivotY",
        "renderWidth",
        "renderHeight",
        "padding"
      ],
      "additionalProperties": false
    },
    "frameSequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sourceIndex": {
            "type": "integer",
            "minimum": 0
          },
          "phase": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1
          },
          "durationMs": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "sourceIndex",
          "phase",
          "durationMs"
        ],
        "additionalProperties": false
      }
    },
    "loop": {
      "type": "boolean"
    },
    "mirrorSource": {
      "type": "null"
    },
    "qualification": {
      "type": "object",
      "properties": {
        "technical": {
          "$ref": "#/$defs/qualification"
        },
        "motion": {
          "$ref": "#/$defs/qualification"
        },
        "runtime": {
          "$ref": "#/$defs/qualification"
        },
        "owner": {
          "$ref": "#/$defs/qualification"
        },
        "release": {
          "$ref": "#/$defs/qualification"
        }
      },
      "required": [
        "technical",
        "motion",
        "runtime",
        "owner",
        "release"
      ],
      "additionalProperties": false
    },
    "scope": {
      "enum": [
        "candidate",
        "production"
      ]
    },
    "distancePerCycle": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "identityId",
    "unitId",
    "assetId",
    "version",
    "archetype",
    "action",
    "direction",
    "canonicalReference",
    "job",
    "descriptor",
    "sources",
    "tool",
    "geometry",
    "frameSequence",
    "loop",
    "mirrorSource",
    "qualification",
    "scope",
    "distancePerCycle",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "pin": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "UNREVIEWED",
            "PASS",
            "FAIL",
            "HELD",
            "NOT_APPLICABLE"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
