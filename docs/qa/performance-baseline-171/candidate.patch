+import test from 'node:test';import assert from 'node:assert/strict';import {statistics,parseConfig} from '../scripts/benchmark-simulation.mjs';
+test('nearest-rank tails expose rare spikes without sorting caller samples',()=>{const values=Array.from({length:100},(_,i)=>i+1).reverse(),copy=[...values];assert.deepEqual(statistics(values),{samples:100,p50:50,p95:95,p99:99,max:100});assert.deepEqual(values,copy);assert.deepEqual(statistics([1,1,100]),{samples:3,p50:1,p95:100,p99:100,max:100});assert.equal(statistics([]).p95,null);assert.throws(()=>statistics([NaN]));});
+test('bounded CLI rejects cap overflow, runaway total work and malformed configuration',()=>{for(const args of [['--worlds','10'],['--worlds','8,8'],['--maps','delta,delta'],['--maps','missing'],['--measure-ticks','0'],['--seed','-1'],['--evolve-seconds','121'],['--wall-seconds','999'],['--unknown','1'],['--maps'],['--worlds','1,2,3,4,5,6,7,8','--evolve-seconds','120','--measure-ticks','400']])assert.throws(()=>parseConfig(args));const c=parseConfig(['--maps','coast','--worlds','1,8','--evolve-seconds','60','--measure-ticks','40','--seed','7']);assert.equal(c.maps[0],'coast');assert.deepEqual(c.worlds,[1,8]);assert.equal(c.evolveSeconds,60);assert.equal(c.seed,7);});
