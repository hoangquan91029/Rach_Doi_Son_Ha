+const asset=(type,state,mask=0)=>({...structuredClone(original),id:`fixture-${type}-${state}-${mask}`,family:`building.${type}`,state,direction:null,frames:[{...original.frames[0],durationMs:75},{...original.frames[0],durationMs:75}],loop:false,...(['wall','gate'].includes(type)?{fortification:{mask}}:{})});
